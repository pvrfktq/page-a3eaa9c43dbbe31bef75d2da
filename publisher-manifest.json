          "body": "<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\nhtml{-webkit-text-size-adjust:100%;font-size:16px}\nbody{font-family:\"Source Han Serif SC\",\"Noto Serif CJK SC\",\"Songti SC\",Georgia,\"Times New Roman\",serif;background:#f7f1e6;color:#3b1f24;line-height:1.7;-webkit-font-smoothing:antialiased;letter-spacing:.01em}\na{color:#7a1c2c;text-decoration:none;border-bottom:1px solid rgba(122,28,44,.3);transition:color .2s ease}\na:hover{color:#3b1f24;border-bottom-color:#3b1f24}\nh1,h2,h3,h4{font-family:\"Source Han Serif SC\",\"Noto Serif CJK SC\",\"Songti SC\",Georgia,serif;color:#3b1f24;font-weight:600;line-height:1.3;letter-spacing:-.005em}\nh1{font-size:clamp(2.1rem,5.2vw,3.8rem);font-weight:700}\nh2{font-size:clamp(1.5rem,3.2vw,2.1rem);margin-bottom:1rem}\nh3{font-size:1.15rem;margin-bottom:.6rem;color:#7a1c2c}\np{margin-bottom:1rem}\n.wrap{max-width:1140px;margin:0 auto;padding:0 1.4rem}\n\n/* HERO — 纵向时间线 */\n.hero{position:relative;padding:5rem 0 4rem;background:linear-gradient(180deg,#f7f1e6 0%,#f3ead7 100%)}\n.hero::before{content:\"\";position:absolute;left:1.4rem;top:0;bottom:0;width:1px;background:linear-gradient(180deg,transparent,#7a1c2c 12%,#7a1c2c 88%,transparent)}\n.hero-grid{display:grid;grid-template-columns:240px 1fr;gap:2.4rem;max-width:1140px;margin:0 auto;padding:0 1.4rem}\n.hero-meta{position:relative;padding-top:.5rem}\n.hero-meta .stamp{display:inline-block;border:1px solid #7a1c2c;padding:.4rem .8rem;font-size:.78rem;color:#7a1c2c;letter-spacing:.18em;text-transform:uppercase;margin-bottom:1.4rem}\n.hero-meta h4{font-size:.85rem;color:#7a1c2c;letter-spacing:.18em;text-transform:uppercase;margin-bottom:1rem}\n.hero-meta ol{list-style:none;font-size:.88rem;color:#7b5660;line-height:1.9;padding-left:0}\n.hero-meta ol li{position:relative;padding-left:1.2rem;margin-bottom:.4rem}\n.hero-meta ol li::before{content:\"\";position:absolute;left:0;top:.65rem;width:6px;height:6px;border-radius:50%;background:#7a