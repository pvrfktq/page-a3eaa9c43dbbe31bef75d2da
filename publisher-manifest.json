uto}\n.plan{display:grid;grid-template-columns:6px 200px 1fr 200px;align-items:stretch;border-left:none;background:#fff8ea;border:1px solid rgba(122,28,44,.18);position:relative}\n.plan .bar{background:#7a1c2c}\n.plan.featured .bar{background:#a02638}\n.plan.featured{box-shadow:-4px 4px 0 #7a1c2c;background:#fdf5e6}\n.plan-head{padding:1.4rem 1.4rem 1.4rem 1.4rem;border-right:1px solid rgba(122,28,44,.12)}\n.plan-head .tier{font-size:.78rem;color:#7a1c2c;letter-spacing:.2em;text-transform:uppercase;margin-bottom:.4rem}\n.plan-head h3{font-size:1.4rem;color:#3b1f24;margin-bottom:0}\n.plan-head .featured-tag{display:inline-block;margin-top:.5rem;font-size:.7rem;background:#7a1c2c;color:#f7f1e6;padding:.2rem .5rem;letter-spacing:.1em}\n.plan-body{padding:1.4rem 1.6rem}\n.plan-body ul{list-style:none;font-size:.92rem;color:#4a2a30;line-height:1.85}\n.plan-body ul li{position:relative;padding-left:1.2rem}\n.plan-body ul li::before{content:\"·\";position:absolute;left:.2rem;color:#7a1c2c;font-weight:bold;font-size:1.2rem;line-height:1.6}\n.plan-foot{padding:1.4rem;border-left:1px solid rgba(122,28,44,.12);text-align:center;background:rgba(122,28,44,.04)}\n.plan-foot .price{font-size:1.45rem;color:#3b1f24;font-weight:600;display:block;margin-bottom:.2rem;letter-spacing:-.01em}\n.plan-foot .unit{font-size:.75rem;color:#7b5660;display:block;margin-bottom:.4rem}\n.plan-foot .annual{display:block;font-size:.78rem;color:#7a1c2c;background:transparent}\n.plan-foot .cta{display:inline-block;margin-top:.8rem;padding:.55rem 1.1rem;background:#3b1f24;color:#f7f1e6;font-size:.82rem;letter-spacing:.12em;border:1px solid #3b1f24;text-decoration:none}\n.plan-foot .cta:hover{background:#7a1c2c;border-color:#7a1c2c;color:#fff}\n\n/* 说明区块 */\n.notes{background:#f7f1e6}\n.notes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}\n.note-card{padding:1.6rem 1.4rem 1.4rem 1.2rem;border:1px solid rgba(122,28,44,.18);background:#fff8ea;position:relative}\n.note-card::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:#7a1c2c}\n.note-card h3{font-size:1.05rem}\n.note-card p{font-size:.88rem;color:#5a3940;margin-bottom:0;line-height:1.65}\n\n/* 客户端与兼容 */\n.clients{background:#f3ead7}\n.client-block{padding:1.6rem 1.6rem 1.4rem;border:1px dashed rgba(122,28,44,.3);background:#fff8ea;display:flex;gap:1.4rem;align-items:flex-start;position:relative}\n.client-block::before{content:\"\";position:absolute;left:0;top:0;bottom:0;width:4px;background:#7a1c2c}\n.client-block .os{font-weight:600;color:#7a1c2c;min-width:80px}\n.client-block p{margin-bottom:0;font-size:.9rem;color:#4a2a30}\n.clients-note{font-size:.82rem;color:#7b5660;margin-top:1.4rem;font-style:italic}\n\n/* FAQ — 按主题分组 */\n.faq{background:#f7f1e6}\n.faq-group{margin-bottom:1.6rem}\n.faq-group h3{font-size:1.05rem;color:#7a1c2c;padding:1rem 1.2rem;border-left:4px solid #7a1c2c;background:#fff8ea;margin-bottom:.6rem;letter-spacing:.06em}\n.faq-group h3 .gno{font-family:Georgia,serif;color:#7a1c2c;opacity:.7;margin-right:.6rem;font-size:.9rem}\n.faq-item{padding:.4rem 1.2rem;border-bottom:1px solid rgba(122,28,44,.1)}\n.faq-q{font-weight:600;color:#3b1f24;padding:.6rem 0;font-size:.95rem;display:flex;align-items:baseline;gap:.6rem}\n.faq-q .qno{font-family:Georgia,serif;color:#7a1c2c;font-size:.85rem;min-width:2.2rem}\n.faq-a{padding:0 0 .8rem 2.2rem;font-size:.88rem;color:#5a3940;line-height:1.7}\n.faq-a p{margin-bottom:.4rem}\n\n/* 结尾 */\n.outro{padding:4rem 0;text-align:center;background:#3b1f24;color:#f3ead7}\n.outro h2{color:#f3ead7;margin-bottom:1rem;font-size:1.8rem}\n.outro p{color:rgba(247,241,230,.8);max-width:52ch;margin:0 auto 1.6rem;font-size:.95rem}\n.outro .signoff{font-family:Georgia,serif;font-style:italic;color:rgba(247,241,230,.6);font-size:.85rem}\n\n/* 底部固定导航 */\n.nav-fixed{position:fixed;left:0;right:0;bottom:0;background:#3b1f24;border-top:1px solid #7a1c2c;z-index:50}\n.nav-fixed ul{list-style:none;display:flex;justify-content:space-around;max-width:680px;margin:0 auto;padding:0}\n.nav-fixed ul li a{display:block;padding:.85rem .4rem;color:#f3ead7;font-size:.78rem;text-decoration:none;border:none;letter-spacing:.12em;text-transform:uppercase;text-align:center}\n.nav-fixed ul li a:hover{color:#d9a8b3}\n.nav-fixed ul li a span{display:block;font-family:Georgia,serif;font-size:.7rem;color:#7a1c2c;letter-spacing:0;text-transform:none;margin-bottom:.15rem}\n\n@media (max-width:820px){\n.hero-grid{grid-template-columns:1fr}\n.hero-meta{padding-bottom:1rem;border-bottom:1px solid rgba(122,28,44,.2);margin-bottom:1rem}\n.hero::before{display:none}\n.tl-grid{grid-template-columns:1fr}\n.tl-grid::before{left:1.4rem}\n.tl-item,.tl-item.left,.tl-item.right{width:100%;padding:1.4rem 0 1.4rem 3rem;text-align:left!important}\n.tl-item.left .dot,.tl-item.right .dot{left:calc(1.4rem - 6px);right:auto}\n.tl-item.left h3,.tl-item.left p{text-align:left}\n.tl-item.right{margin-top:.4rem}\n.plan{grid-template-columns:4px 1fr}\n.plan-head,.plan-body,.plan-foot{border-left:none;border-right:none;padding:1.1rem 1.2rem;width:100%}\n.plan-head{border-bottom:1px solid rgba(122,28,44,.12)}\n.plan-foot{border-top:1px solid rgba(122,28,44,.12)}\n.notes-grid{grid-template-columns:1fr}\n.client-block{flex-direction:column;gap:.4rem}\nh1{font-size:2rem}\n.section{padding:3rem 0}\n}\n</style><header class=\"hero\">\n<div class=\"hero-grid\">\n<aside class=\"hero-meta\">\n<div class=\"stamp\">FastVPN · 卷一</div>\n<h1>FastVPN · 本期目录</h1>\n<ol>\n<li>引言：为什么要做这件事</li>\n<li>时间线：从一笔订单说起</li>\n<li>三档订阅如何分配</li>\n<li>使用须知与限制</li>\n<li>跨平台客户端说明</li>\n<li>读者来信与答复</li>\n<li>写在最后</li>\n</ol>\n</aside>\n<div class=\"hero-text\">\n<h2>用一根专线，把网络还给使用者。</h2>\n<p class=\"lead\">这是一篇关于 FastVPN 的专栏式自述。我们是一支做网络通道服务的团队，过去几年一直在写代码、跑线路、接工单。本文记录的不是营销话术，而是从一笔订单、一封投诉、一次深夜抢修里长出来的产品观。</p>\n<div class=\"hero-meta-line\">\n<span><strong>5</strong>平台</span>\n<span><strong>3</strong>订阅档</span>\n<span><strong>7×24</strong>工单</span>\n<span><strong>2019</strong>起</span>\n</div>\n</div>\n</div>\n</header>\n\n<main>\n\n<section class=\"timeline\">\n<div class=\"wrap\">\n<div class=\"section-title\">\n<span class=\"num\" id=\"tl-h\">§02</span>\n<h2>从一笔订单说起</h2>\n<span class=\"sub\">向下滚动 · 纵向时间线</span>\n</div>\n</div>\n<div class=\"tl-grid\">\n<article class=\"tl-item left\">\n<span class=\"dot\"></span>\n<span class=\"year\">2019 · 春</span>\n<h3>一封来自用户的越洋邮件</h3>\n<p>团队最早由三位工程师组成，接到一封从海外发来的邮件：希望在异国也能顺畅看到家里的流媒体。我们花了三个月搭通了第一条专线，那也是 FastVPN 名字出现的第一天。</p>\n</article>\n<article class=\"tl-item right\">\n<span class=\"dot\"></span>\n<span class=\"year\">2020 · 冬</span>\n<h3>第一次被 DDoS 击中</h3>\n<p>一次规模不小的攻击让节点连续六小时不可达。我们由此写下了内部第一版应急手册——这件事后来成为旗舰版「优先工单支持」机制的起点。</p>\n</article>\n<article class=\"tl-item left\">\n<span class=\"dot\"></span>\n<span class=\"year\">2022 · 夏</span>\n<h3>推出企业定制路由</h3>\n<p>不再只做个人订阅，几家远程协作的小型工作室找到我们，催生了团队版的雏形：更高带宽、更稳定的路由策略，以及一位对得上话的专属客户经理。</p>\n</article>\n<article class=\"tl-item right\">\n<span class=\"dot\"></span>\n<span class=\"year\">2024 · 秋</span>\n<h3>三档订阅正式成型</h3>\n<p>我们把功能差异、价格梯度写进一封给老用户的公开信里，并从此不再做「加钱解锁全部节点」式的销售话术。这是本页所列订阅结构的起点。</p>\n</article>\n</div>\n</section>\n\n<section class=\"section plans\">\n<div class=\"wrap\">\n<div class=\"section-title\">\n<span class=\"num\" id=\"plan-h\">§03</span>\n<h2>三档订阅，按你的节奏选择</h2>\n<span class=\"sub\">阶梯式 · 自下而上叠加</span>\n</div>\n<div class=\"plan-stairs\">\n\n<article class=\"plan\">\n<div class=\"bar\"></div>\n<div class=\"plan-head\">\n<div class=\"tier\">第一阶 · 入门</div>\n<h3>基础版</h3>\n</div>\n<div class=\"plan-body\">\n<ul>\n<li>每月 100GB 极速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</div>\n<div class=\"plan-foot\">\n<span class=\"price\">¥15</span>\n<span class=\"unit\">/月</span>\n<span class=\"annual\">按年付仅需 ¥150/年</span>\n<a href=\"#\" class=\"cta\">开通基础版</a>\n</div>\n</article>\n\n<article class=\"plan featured\">\n<div class=\"bar\"></div>\n<div class=\"plan-head\">\n<div class=\"tier\">第二阶 · 推荐</div>\n<h3>旗舰版</h3>\n<span class=\"featured-tag\">多数订阅者</span>\n</div>\n<div class=\"plan-body\">\n<ul>\n<li>每月 300GB 极速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n</div>\n<div class=\"plan-foot\">\n<span class=\"price\">¥35</span>\n<span class=\"unit\">/月</span>\n<span class=\"annual\">按年付仅需 ¥350/年</span>\n<a href=\"#\" class=\"cta\">开通旗舰版</a>\n</div>\n</article>\n\n<article class=\"plan\">\n<div class=\"bar\"></div>\n<div class=\"plan-head\">\n<div class=\"tier\">第三阶 · 团队</div>\n<h3>团队版</h3>\n</div>\n<div class=\"plan-body\">\n<ul>\n<li>每月 1000GB 极速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</div>\n<div class=\"plan-foot\">\n<span class=\"price\">¥85</span>\n<span class=\"unit\">/月</span>\n<span class=\"annual\">按年付仅需 ¥850/年</span>\n<a href=\"#\" class=\"cta\">开通团队版</a>\n</div>\n</article>\n\n</div>\n</div>\n</section>\n\n<section class=\"section notes\">\n<div class=\"wrap\">\n<div class=\"section-title\">\n<span class=\"num\" id=\"note-h\">§04</span>\n<h2>使用须知与限制</h2>\n<span class=\"sub\">订阅前请先读</span>\n</div>\n<div class=\"notes-grid\">\n<article class=\"note-card\">\n<h3>流量与计费周期</h3>\n<p>每档订阅的流量额度按自然月重置，月底未用尽的剩余流量不会结转至次月。我们建议在月初评估当月出差或远程办公的天数，再决定是否升级。</p>\n</article>\n<article class=\"note-card\">\n<h3>同时在线设备</h3>\n<p>「同时在线」指并发活跃连接数，而非累计绑定设备。同一账号可在远多于额度上限的设备上登录，但同一时间仅允许额度内数量的会话保持活动。</p>\n</article>\n<article class=\"note-card\">\n<h3>退款与续费</h3>\n<p>首次开通 7 天内若出现套餐说明与实际不符的严重情况，可提交工单申请全额退款；续费将于到期前 3 天发起提醒并自动扣款，可在控制台关闭自动续费。</p>\n</article>\n</div>\n</div>\n</section>\n\n<section class=\"section clients\">\n<div class=\"wrap\">\n<div class=\"section-title\">\n<span class=\"num\" id=\"cli-h\">§05</span>\n<h2>跨平台客户端说明</h2>\n<span class=\"sub\">以系统为单位分述</span>\n</div>\n\n<article class=\"client-block\">\n<div class=\"os\">Windows</div>\n<p>提供桌面客户端安装包，支持 Windows 10 及以上版本，开机自启与系统代理可分别设置。</p>\n</article>\n<article class=\"client-block\">\n<div></div>\n<article class=\"client-block\">\n<div class=\"os\">macOS</div>\n<p>提供 Apple Silicon 与 Intel 双架构安装包，与系统网络扩展协同，可在状态栏显示节点与流量。</p>\n</article>\n<article class=\"client-block\">\n<div class=\"os\">iOS</div>\n<p>iPhone 与 iPad 通过 App 内嵌的配置描述文件建立通道，首次启用需要授予 VPN 配置权限。</p>\n</article>\n<article class=\"client-block\">\n<div class=\"os\">Android</div>\n<p>提供 APK 与各大应用市场版本，支持后台长连接与按 Wi-Fi/蜂窝分别路由。</p>\n</article>\n<article class=\"client-block\">\n<div class=\"os\">路由器</div>\n<p>支持部分主流 OpenWrt 固件与华硕 Merlin 插件，可在路由器层面覆盖家庭所有联网设备。</p>\n</article>\n\n<p class=\"clients-note\">注：以上客户端的具体下载地址以订阅后站内信与控制台给出的链接为准，下载前请核对文件签名。</p>\n\n</article></div>\n</section>\n\n<section class=\"section faq\">\n<div class=\"wrap\">\n<div class=\"section-title\">\n<span class=\"num\" id=\"faq-h\">§06</span>\n<h2>读者来信与答复</h2>\n<span class=\"sub\">按主题分组</span>\n</div>\n\n<div class=\"faq-group\">\n<h3><span class=\"gno\">A</span>关于订阅与计费</h3>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q1.</span><span>三档订阅可以随时升降吗？</span></div>\n<div class=\"faq-a\"><p>可以。在订阅有效期内进入控制台「我的套餐」选择新档，差价按剩余天数折算补缴或抵扣；降档则在当前周期结束后生效。</p></div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q2.</span><span>按月付和按年付的节点资源相同吗？</span></div>\n<div class=\"faq-a\"><p>相同。年付仅在价格上提供折扣，并不会因为付款方式而分配到不同的节点池或流量额度。</p></div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<h3><span class=\"gno\">B</span>关于节点与线路</h3>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q3.</span><span>基础版的「普通线路节点池」具体指什么？</span></div>\n<div class=\"faq-a\"><p>指公网骨干 BGP 路由池，覆盖常见的城市与运营商方向，适合一般浏览、办公与基础流媒体。旗舰版与团队版则在此之上叠加 IPLC 专线和高带宽节点。</p></div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q4.</span><span>为什么有时延却没掉线？</span></div>\n<div class=\"faq-a\"><p>通道有时延不等于连接中断：当你看到页面加载比平时慢一截，但浏览器地址栏仍显示已连接，是通道在重路由或在切换线路，不会消耗额外的并发设备数。</p></div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<h3><span class=\"gno\">C</span>关于客户端与设备</h3>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q5.</span><span>同一账号可以在手机和电脑上同时登录吗？</span></div>\n<div class=\"faq-a\"><p>可以。各档订阅的「同时在线」数量是并发活跃会话上限，例如旗舰版允许同时有 5 个活跃会话，超过部分会自动挤掉最早建立的会话。</p></div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q6.</span><span>在路由器上配置会让家里所有设备都计入并发吗？</span></div>\n<div class=\"faq-a\"><p>不会。使用路由器插件时，路由器作为单一客户端计入并发额度，其下连接的电视、手机、PC 共享这一会话，不重复扣减。</p></div>\n</div>\n</div>\n\n<div class=\"faq-group\">\n<h3><span class=\"gno\">D</span>关于售后与工单</h3>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q7.</span><span>工单多久会被看到？</span></div>\n<div class=\"faq-a\"><p>基础版按工作日轮值处理，多数在 24 小时内响应；旗舰版与团队版为 7×24 优先工单，通常在数小时内首次回复，严重故障会电话或站内信通知。</p></div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\"><span class=\"qno\">Q8.</span><span>团队版的「专属客户经理」承担哪些事务？</span></div>\n<div class=\"faq-a\"><p>负责处理开通、退订、发票、合同等商务流程，并对接企业内多人共享账号时的权限分配；不参与具体技术排障的代码层细节。</p></div>\n</div>\n</div>\n\n</div>\n</section>\n\n<section class=\"outro\">\n<div class=\"wrap\">\n<h2>写在最后</h2>\n<p>做网络通道服务是一件慢事，线路在变、协议在变、用户的用法也在变。我们更愿意把每个档位的每一行写清楚，而不是把它藏在一句「极速稳定」里。如果你看完本页还有疑问，欢迎在订阅后通过工单继续问下去。</p>\n<div class=\"signoff\">—— FastVPN 编辑部</div>\n</div>\n</section>\n\n</main>\n\n<nav class=\"nav-fixed\" aria-label=\"页脚固定导航\">\n<ul>\n<li><a href=\"#\"><span>01</span>引言</a></li>\n<li><a href=\"#tl-h\"><span>02</span>时间线</a></li>\n<li><a href=\"#plan-h\"><span>03</span>订阅</a></li>\n<li><a href=\"#note-h\"><span>04</span>须知</a></li>\n<li><a href=\"#cli-h\"><span>05</span>客户端</a></li>\n<li><a href=\"#faq-h\"><span>06</span>问答</a></li>\n</ul>\n</nav>",
